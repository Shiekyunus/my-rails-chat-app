<div class="container py-4">

  <div class="d-flex justify-content-between align-items-center mb-4">

    <h1 class="fw-bold">
      Search Result
    </h1>

    <%= link_to "Back to Home",
                users_path,
                class: "btn btn-outline-secondary" %>

  </div>

  <% if @searched_user %>

    <div class="card shadow-sm mb-4">

      <div class="card-body d-flex align-items-center gap-3">

        <% if @searched_user.profile_image.attached? %>

          <%= image_tag @searched_user.profile_image,
                        width: 80,
                        height: 80,
                        class: "rounded-circle" %>

        <% else %>

          <%= image_tag "default profile image.webp",
                        width: 80,
                        height: 80,
                        class: "rounded-circle" %>

        <% end %>

        <div>

          <h3 class="mb-1">
            <%= @searched_user.name %>
          </h3>

          <p class="text-muted mb-0">
            <%= @searched_user.email %>
          </p>

        </div>

      </div>

    </div>

    <% if @conversations.any? %>

      <% @conversations.each do |conversation| %>

        <% other_user =
             conversation.users.where.not(id: @searched_user.id).first %>

        <% sent_count =
             conversation.messages.where(user: @searched_user).count %>

        <% received_count =
             conversation.messages.where(user: other_user).count %>

        <div class="card mb-3 shadow-sm">

          <div class="card-body">

            <div class="d-flex justify-content-between align-items-center">

              <div>

                <h5 class="fw-bold mb-2">
                  <%= other_user.name %>
                </h5>

                <p class="mb-1">
                  <span class="badge bg-primary">
                    Sent:
                    <%= sent_count %>
                  </span>
                </p>

                <p class="mb-0">
                  <span class="badge bg-success">
                    Received:
                    <%= received_count %>
                  </span>
                </p>

              </div>

            </div>

          </div>

        </div>

      <% end %>

    <% else %>

      <div class="alert alert-info">
        No conversations found for this user.
      </div>

    <% end %>

  <% else %>

    <div class="alert alert-danger">
      User not found
    </div>

  <% end %>

</div>