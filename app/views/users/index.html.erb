<div class="d-flex justify-content-between align-items-center pb-3 border-bottom">

  <h1>
    Users
  </h1>


</div>

<div class="card p-3 mb-4">

  <h4 class="mb-3">
    Search User
  </h4>

  <%= form_with url: search_users_path,
                method: :get,
                local: true,
                class: "row g-2" do |f| %>

    <div class="col-md-4">

      <%= f.text_field :email,
                       placeholder: "Enter email",
                       class: "form-control" %>

    </div>

    <div class="col-md-2">

      <%= f.submit "Search",
                   class: "btn btn-primary w-100" %>

    </div>

  <% end %>

</div>

<% @users.each do |user| %>

  <div class="card mb-3">

    <div class="card-body d-flex align-items-center justify-content-between">

      <div class="d-flex align-items-center gap-3">

        <% if user.profile_image.attached? %>

          <%= image_tag user.profile_image,
                        width: 70,
                        height: 70,
                        class: "rounded-circle" %>

        <% else %>

          <%= image_tag "default profile image.webp",
                        width: 70,
                        height: 70,
                        class: "rounded-circle" %>

        <% end %>

        <div>

          <h4 class="mb-1">
            <%= user.name %>
          </h4>

          <p class="mb-1 text-muted">
            <%= user.email %>
          </p>

        </div>

      </div>

      <%= button_to "Chat",
                    conversations_path(receiver_id: user.id),
                    method: :post,
                    class: "btn btn-success" %>

    </div>

  </div>

<% end %>

<%= paginate @users %>