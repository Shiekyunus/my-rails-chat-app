document.getElementById("messages").innerHTML += `
  <p>

    <strong>
      <%= @message.user.name %>
    </strong>

    :

    <%= j @message.body %>

    <small>
      (<%= @message.created_at.strftime("%d %b %Y, %I:%M %p") %>)
    </small></p>
  ✓ Sent
`;

document.querySelector("textarea").value = "";

window.scrollTo(
  0,
  document.body.scrollHeight
);