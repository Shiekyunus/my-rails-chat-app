            "log_group_name": "/ecs/shiek-terraform/ror",
            "log_stream_name": "ecs/puma/{instance_id}",
            "timezone": "UTC"
          },
          {
            "file_path": "/app/log/error.log",
            "log_group_name": "/ecs/shiek-terraform/ror",
            "log_stream_name": "ecs/errors/{instance_id}",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
